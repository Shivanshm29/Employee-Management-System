# Django
DJANGO_SECRET_KEY=your-very-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (set USE_POSTGRES=True and fill below to use PostgreSQL)
